# Gradle
.gradle/
build/
**/build/
!gradle/wrapper/gradle-wrapper.jar

# Android Studio and IntelliJ IDEA (any depth, e.g. phone/.idea/; no IDE file is tracked)
*.iml
.idea/

# Local SDK and machine-specific configuration
local.properties

# Signing and secrets. The AI key is read from local.properties (AI_API_KEY) at build time, never from a tracked file.
*.jks
*.keystore
keystore.properties
secrets.properties
.env
.env.*
*.pem
*.p12

# Native build output
.cxx/
.externalNativeBuild/

# Android build artifacts and reports
captures/
*.apk
*.aab
output-metadata.json

# Kotlin and JVM tooling
.kotlin/
*.hprof

# Debug logs and exports (detection log, CSV exports)
*.log
detection*.csv
voxara_*.csv

# Audio and training data (add a small fixture under src/test/resources if a test needs one)
*.wav
*.flac
*.mp3
!**/src/test/resources/**
!**/src/androidTest/assets/**

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Local agent state
.claude/settings.local.json
.claude/projects/
.github/modernize/

# Images and video: screenshots, renders and comparisons are regenerated by the screenshot tests and kept locally only.
# App resources under res/ and the Play Store assets still go in; vector sources (.svg) are not ignored.
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.bmp
*.mp4
*.mov
*.webm
!**/src/**/res/**
!docs/design/icons/store/*.png

# Images already in the repo before this rule (e.g. docs/design/phone-redesign/concepts/) stay tracked until removed with git rm --cached.
