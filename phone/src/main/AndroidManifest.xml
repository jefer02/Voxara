<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Voxara phone companion (v2). Headphone sampling (optional, OFF by default) reads only which
        audio output is connected (by type), whether media is playing, and the media volume. Never
        titles, app names, device names or addresses. BLUETOOTH_CONNECT is needed to receive
        Bluetooth connection broadcasts (API 31+) and is asked in context.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <!-- Sync problems and, if the wearer turns it on, mirrored 100% alerts. Asked in context. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Headphone listening on this phone (opt-in) keeps a foreground service of type connectedDevice.
        Android requires FOREGROUND_SERVICE_CONNECTED_DEVICE for that type and, as a prerequisite, that the
        app declares one of CHANGE_NETWORK_STATE / CHANGE_WIFI_STATE / ... or holds a Bluetooth permission.
        BLUETOOTH_CONNECT is optional here (it only tells a speaker from headphones), so a normal permission
        is declared to satisfy the prerequisite whether or not it is granted. Voxara changes no network state.
    -->
    <!-- The headphone-volume alert vibrates the phone (the same family of pattern as on the watch). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- Start watching for headphones again after a reboot (the foreground service may start from boot). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- "Open the Galaxy Wearable app": the apps that pair a watch with this phone. -->
    <queries>
        <package android:name="com.samsung.android.app.watchmanager" />
        <package android:name="com.google.android.apps.wear.companion" />
        <package android:name="com.google.android.wearable.app" />
    </queries>

    <!--
        allowBackup=false plus data extraction rules: the exposure history, settings and status on
        this phone are excluded from cloud backup AND device-to-device transfer.
    -->
    <application
        android:name=".VoxaraPhoneApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/phone_app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.VoxaraPhone">

        <!-- uiMode: Settings → Appearance changes the theme live (and the app night mode for the
             splash); Compose redraws, the activity is not recreated. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Exempt Bluetooth broadcasts: sample at connect / disconnect edges. -->
        <receiver
            android:name=".HeadphoneConnectionReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.a2dp.profile.action.CONNECTION_STATE_CHANGED" />
                <action android:name="android.bluetooth.headset.profile.action.CONNECTION_STATE_CHANGED" />
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
            </intent-filter>
        </receiver>

        <!-- Watches for headphones (events: devices, playback, volume) while the wearer shares listening with the watch. -->
        <service
            android:name=".listening.PhoneListeningService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <receiver
            android:name=".listening.PhoneBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- "Dismiss" / "Lower to safe volume" on the headphone-volume alert. -->
        <receiver
            android:name=".listening.PhoneAlertActionReceiver"
            android:exported="false" />

        <!-- The Voxara watch app (same app id + signature only): status, settings, capability. -->
        <service
            android:name=".sync.PhoneListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:host="*"
                    android:pathPrefix="/voxara/status"
                    android:scheme="wear" />
                <data
                    android:host="*"
                    android:pathPrefix="/voxara/settings/watch"
                    android:scheme="wear" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:host="*"
                    android:path="/voxara/alert/limit"
                    android:scheme="wear" />
            </intent-filter>
            <!-- The watch asks the phone to lower its music volume. -->
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:host="*"
                    android:path="/voxara/hp/cmd/lower"
                    android:scheme="wear" />
            </intent-filter>
            <!-- The wearer said on the watch that the phone's output is not headphones. -->
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:host="*"
                    android:path="/voxara/hp/cmd/not_headphones"
                    android:scheme="wear" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.CAPABILITY_CHANGED" />
                <data
                    android:host="*"
                    android:path="/voxara_watch_app"
                    android:scheme="wear" />
            </intent-filter>
        </service>

        <!-- Home-screen widget: today's dose from the watch, with its time (refreshed after each sync). -->
        <receiver
            android:name=".widget.DoseWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/dose_widget_info" />
        </receiver>

        <!-- CSV export through the share sheet (files in the cache, read-only grants). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.export"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/export_paths" />
        </provider>
    </application>

</manifest>
